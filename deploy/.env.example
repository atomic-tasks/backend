# Прод: скопируйте в /opt/atomic-tasks/.env на сервере, chmod 600. Подробно — docs/deploy.md.
# Значения со скобками <...> заменить. Секреты генерировать на сервере, в git не класть.

# --- Хосты и Traefik ---
API_HOST=<atomic.example.com>
AUTH_HOST=<auth.example.com>
# Внешняя сеть Traefik: docker network ls
TRAEFIK_NETWORK=<traefik>
# Её подсеть: docker network inspect <сеть> -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRAEFIK_SUBNET=<172.18.0.0/16>
# Имена из статического конфига Traefik (entryPoints и certificatesResolvers)
TRAEFIK_ENTRYPOINT=<websecure>
TRAEFIK_CERTRESOLVER=<letsencrypt>
# Внутренняя сеть стека; менять, только если пересекается с существующей
#INTERNAL_SUBNET=172.31.250.0/24
# Образ; по умолчанию ghcr.io/atomic-tasks/backend
#IMAGE=ghcr.io/atomic-tasks/backend

# --- Postgres ---
POSTGRES__USER=atomic_tasks
# openssl rand -hex 24
POSTGRES__PASSWORD=
POSTGRES__DB=atomic_tasks

# --- Rauthy ---
# Служебный администратор, не рабочий email (ADR 0009)
RAUTHY_ADMIN_EMAIL=<admin@example.com>
# openssl rand -hex 24
RAUTHY_DB_PASSWORD=
# echo "$(openssl rand -hex 4)/$(openssl rand -base64 32)"
RAUTHY_ENC_KEYS=
# часть RAUTHY_ENC_KEYS до "/"
RAUTHY_ENC_KEY_ACTIVE=
# openssl rand -hex 24, разные
RAUTHY_HQL_SECRET_RAFT=
RAUTHY_HQL_SECRET_API=

# --- Вход через Rauthy в бэкенде ---
# client id наших приложений в Rauthy (aud)
AUTH__AUDIENCE=["atomic-tasks-swagger"]
AUTH__SWAGGER_CLIENT_ID=atomic-tasks-swagger
# Кого пускать при первом входе
AUTH__ALLOWED_EMAILS=["<you@example.com>"]

# Клиенты MCP, заведённые в Rauthy вручную (JSON-список в одну строку), — если Rauthy не может скачать
# CIMD-документ клиента (например, claude.ai отвечает серверу 403). Встроенный список не повторять.
# MCP__EXTRA_TRUSTED_CLIENTS=["claude-connector"]
