# Скопируйте в .env. Вложенные настройки разделяются двойным подчёркиванием.
DEBUG=false

POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=atomic_tasks
POSTGRES__PASSWORD=atomic_tasks
POSTGRES__DB=atomic_tasks
POSTGRES__ECHO=false

# JSON-список значений Host, с которых принимаются MCP-запросы
MCP__ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]

# --- Rauthy (IdP) — см. docs/dev/rauthy.md ---
RAUTHY_ADMIN_EMAIL=admin@localhost
RAUTHY_DB_PASSWORD=change-me
# Ключ шифрования: "<id>/<32 байта в base64>", id — 2–20 символов [a-zA-Z0-9:_-].
# Сгенерировать: echo "$(openssl rand -hex 4)/$(openssl rand -base64 32)"
RAUTHY_ENC_KEYS=
RAUTHY_ENC_KEY_ACTIVE=
# Не короче 16 символов, разные. Сгенерировать: openssl rand -hex 24
RAUTHY_HQL_SECRET_RAFT=
RAUTHY_HQL_SECRET_API=

# --- Вход через Rauthy в бэкенде — см. docs/dev/rauthy.md, раздел про Swagger ---
# Ровно как claim iss в токене — у Rauthy со слешем на конце
AUTH__ISSUER=http://localhost:8080/auth/v1/
# JSON-список client id, чьи токены принимаем (aud). Пусто — вход через IdP выключен.
AUTH__AUDIENCE=["atomic-tasks-swagger"]
AUTH__SWAGGER_CLIENT_ID=atomic-tasks-swagger
# Кого пускать при первом входе. Пусто — регистрация закрыта.
AUTH__ALLOWED_EMAILS=["you@example.com"]
