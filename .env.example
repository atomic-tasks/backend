# Скопируйте в .env. Вложенные настройки разделяются двойным подчёркиванием.
DEBUG=false

POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=atomic_tasks
POSTGRES__PASSWORD=atomic_tasks
POSTGRES__DB=atomic_tasks
POSTGRES__ECHO=false

# JSON-список значений Host, с которых принимаются MCP-запросы
MCP__ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]
